#!/bin/sh
# OCI poststop hook: commit container on exit 42.
# Install: copy to /etc/containers/oci-hook.d/post-stop or configure in containers.conf.
#
# Usage: exit 42 from inside container to trigger commit.
# Container keeps running until it exits normally.

CONTAINER_NAME="${1}"
EXIT_CODE="${2}"

if [ "$EXIT_CODE" -eq 42 ]; then
  podman commit "$CONTAINER_NAME" localhost/goclaw:latest 2>/dev/null && echo "✅ Committed $CONTAINER_NAME" || true
fi