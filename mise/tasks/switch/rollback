#!/bin/bash
#MISE description="Rollback to previous version / Setup auto-rollback"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

MARKER="${GOCLAW_HOME:-$HOME/.goclaw}/BUILD-PENDING-ROLLBACK"
AUTOROLLBACK_SECONDS="${AUTOROLLBACK_SECONDS:-600}"

# Mode 1: Prepare - start background timer and return immediately
if [ "${1:-}" = "--prepare" ]; then
    echo "[AUTOROLLBACK] Starting timer (${AUTOROLLBACK_SECONDS}s)..."
    echo "$$" > "$MARKER"
    
    # Background process that does rollback if timer expires
    (
        sleep "$AUTOROLLBACK_SECONDS"
        if [ -f "$MARKER" ]; then
            echo "[AUTOROLLBACK] Timer expired, rolling back..."
            exec "$0"
        fi
    ) &
    
    echo "[AUTOROLLBACK] Timer started in background"
    exit 0
fi

# Mode 2: Perform rollback (called by timer or manually)
if [ -f "$MARKER" ]; then
    echo "[ROLLBACK] Auto-rollback triggered"
    rm -f "$MARKER"
else
    # Manual rollback - require confirmation
    if [ ! -d "build-prev" ]; then
        echo "[ROLLBACK] No previous build found."
        exit 1
    fi
    echo "[ROLLBACK] Manual rollback"
fi

echo "[ROLLBACK] Stopping goclaw service..."
if command -v goclaw &>/dev/null; then
    goclaw service stop 2>/dev/null || true
elif command -v goclaw-manager &>/dev/null; then
    goclaw-manager service stop 2>/dev/null || true
elif systemctl --user is-active goclaw &>/dev/null; then
    systemctl --user stop goclaw
fi

echo "[ROLLBACK] Restoring previous build..."
rm -rf build-next
mv build-current build-next
mv build-prev build-current

echo "[ROLLBACK] Restarting goclaw service..."
if command -v goclaw &>/dev/null; then
    goclaw service start 2>/dev/null || true
elif command -v goclaw-manager &>/dev/null; then
    goclaw-manager service start 2>/dev/null || true
elif systemctl --user list-unit-files | grep -q goclaw; then
    systemctl --user start goclaw
fi

echo "[ROLLBACK] Done."
